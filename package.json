{
  "name": "douyin-comment-collector",
  "version": "2.0.0",
  "description": "抖音网页版评论采集和私信工具",
  "main": "main-collector.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0 <27"
  },
  "scripts": {
    "start": "electron .",
    "collector": "electron main-collector.js",
    "cli": "node collector-cli.js",
    "direct": "node douyin-auto.js",
    "debug": "node debug-comments.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node --test integration/*.test.js",
    "check": "node --check douyin-comment-collector.js && node --check account-profile-manager.js && node --check main-collector.js && node --check preload.js && node --check collector-cli.js && npm test",
    "browser:install": "puppeteer browsers install chrome",
    "build": "electron-builder --mac",
    "build-dmg": "electron-builder --mac --arm64 --x64"
  },
  "keywords": [
    "douyin",
    "automation",
    "puppeteer",
    "comment-collector"
  ],
  "author": "wu",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "puppeteer": "25.12.0"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.douyin.commentcollector",
    "productName": "抖音评论采集工具",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "files": [
      "main-collector.js",
      "message-editor.js",
      "account-profile-manager.js",
      "preload.js",
      "comment-collector.html",
      "douyin-auto.js",
      "douyin-comment-collector.js",
      "collector-cli.js",
      "package.json"
    ]
  }
}
